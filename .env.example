# Values in <> are filled in by the generator in the README's step 2.

# Timezone for all services
TZ=Europe/Prague

# ChirpStack — PG password, first start only
CHIRPSTACK_PG_PASSWORD=<openssl rand -base64 32 | tr -d '=+/'>
# Signing key for login/API tokens, not a hash
CHIRPSTACK_SECRET=<openssl rand -base64 32 | tr -d '=+/'>

# TimescaleDB — owner, used by Node-RED to write
TSDB_USER=postgres
TSDB_PASSWORD=<openssl rand -base64 32 | tr -d '=+/'>
TSDB_DB=metrics

# Grafana — first start only
GRAFANA_ADMIN_PASSWORD=<openssl rand -base64 32 | tr -d '=+/'>
# Grafana's own TimescaleDB role, read-only, created on first DB start
GRAFANA_DB_USER=grafana
GRAFANA_DB_PASSWORD=<openssl rand -base64 32 | tr -d '=+/'>

# Node-RED — encrypts flows_cred.json, back this up
NODE_RED_CREDENTIAL_SECRET=<openssl rand -base64 32 | tr -d '=+/'>
NODE_RED_ADMIN_USER=admin
# Editor login, hashed at container start
NODE_RED_ADMIN_PASSWORD=<openssl rand -base64 32 | tr -d '=+/'>

# Caddy — second-level domain only, services live on subdomains of it
DOMAIN=example.com
# DigitalOcean API token, custom scope "domain" is enough (DNS-01 challenge)
DO_API_TOKEN=
# Optional, Let's Encrypt expiry notices
ACME_EMAIL=

# Home broker accounts — configuration/mqtt/passwd is generated from these

MQTT_CHIRPSTACK_USER=chirpstack
MQTT_CHIRPSTACK_PASSWORD=<openssl rand -base64 32 | tr -d '=+/'>

MQTT_NODERED_USER=nodered
MQTT_NODERED_PASSWORD=<openssl rand -base64 32 | tr -d '=+/'>

MQTT_VICTRON_USER=victron
MQTT_VICTRON_PASSWORD=<openssl rand -base64 32 | tr -d '=+/'>

MQTT_LOXONE_USER=loxone
MQTT_LOXONE_PASSWORD=<openssl rand -base64 32 | tr -d '=+/'>

MQTT_EXPLORER_USER=explorer
MQTT_EXPLORER_PASSWORD=<openssl rand -base64 32 | tr -d '=+/'>

MQTT_FAIKIN_USER=faikin
MQTT_FAIKIN_PASSWORD=<openssl rand -base64 32 | tr -d '=+/'>

MQTT_SHELLY_USER=shelly
MQTT_SHELLY_PASSWORD=<openssl rand -base64 32 | tr -d '=+/'>

MQTT_NUKI_USER=nuki
MQTT_NUKI_PASSWORD=<openssl rand -base64 32 | tr -d '=+/'>

MQTT_ESP32_USER=esp32
MQTT_ESP32_PASSWORD=<openssl rand -base64 32 | tr -d '=+/'>
